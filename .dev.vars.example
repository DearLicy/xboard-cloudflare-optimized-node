# Copy to .dev.vars for local testing; never commit populated credentials.
# For production, add runtime values in Settings > Variables and Secrets.
# Workers Builds variables are build-only, not runtime variables.
PANEL_URL=https://panel.example.com
MACHINE_ID=4
# PANEL_TOKEN, PATH_TOKEN and ADMIN_TOKEN must be independent Secrets in production.
PANEL_TOKEN=replace-with-the-dedicated-worker-machine-token
PATH_TOKEN=replace-with-a-random-64-character-hex-token
ADMIN_TOKEN=replace-with-a-different-random-64-character-hex-token
# Replace node_id with a real XBoard node associated with MACHINE_ID.
# Use examples/region-map.example.json as the production multi-region template.
REGION_MAP='{"cf-asia-ne.example.com":{"node_id":6,"location_hint":"apac-ne","path":"/cf-vless"}}'
WS_PATH=/cf-vless
USER_SYNC_SECONDS=60
REPORT_SECONDS=60
MAX_CONNECTIONS=128
MAX_USER_CONNECTIONS=16
MAX_PENDING_BYTES=104857600
# Optional destination TCP port allowlist. Unset allows all legal ports except 25.
# ALLOWED_PORTS=80,443
